amends "package://github.com/jdx/hk/releases/download/v1.0.0/hk@1.0.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.0.0/hk@1.0.0#/Builtins.pkl"

local elixir_files = List("*.ex", "*.exs")

local elixir_stage = (Step) {
  glob = elixir_files
  exclude = List("deps/**/*")
  stage = glob
}

local linters = new Mapping<String, Step> {
  ["prettier"] = (Builtins.prettier) {
    batch = false
  }
  ["mix compile"] = (elixir_stage) {
    check = "mix compile --warnings-as-errors --strict-warnings"
  }
  ["mix format"] = (elixir_stage) {
    check = "mix format --check-formatted {{files}}"
    fix = "mix format {{files}}"
    depends = List("mix compile")
  }
  ["pkl"] {
    glob = "*.pkl"
    // Workflow modules belong to the .github Pkl project and only render through index.pkl.
    exclude = List(".github/**/*")
    check = "pkl eval {{files}} >/dev/null"
  }
  ["github workflows"] {
    glob = List(".github/**/*.pkl", ".github/PklProject")
    stage = List(".github/workflows/*.yml", ".github/dependabot.yml")
    check = #"""
      out=$(mktemp -d) && pkl eval --project-dir .github -m "$out" .github/index.pkl >/dev/null \
        && (cd "$out" && find * -type f) | while read -r f; do cmp -s "$out/$f" ".github/$f" || { echo "stale: .github/$f"; exit 1; }; done
      """#
    fix = "pkl eval --project-dir .github -m .github .github/index.pkl >/dev/null"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "patch-file"
    steps = linters
  }
  ["fix"] {
    fix = true
    stash = "patch-file"
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
